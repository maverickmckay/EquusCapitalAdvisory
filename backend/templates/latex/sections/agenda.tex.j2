%% ANNUAL MEETING AGENDA
\section{ {{ meeting_year }} Annual Meeting Agenda}

\subsection*{Annual Meeting Agenda}
\vspace{-0.6em}

\noindent
\textbf{ {{ association_name | tex_escape }} }\\
\textbf{ {{ meeting_year }} Annual Meeting Agenda}\\
{% if meeting.meeting_date %}
\textbf{
{{ meeting.meeting_date | format_date }}
{% if meeting.meeting_time %} --- {{ meeting.meeting_time }}{% endif %}
}
{% endif %}

\vspace{0.5em}

\begin{enumerate}[leftmargin=1.4em]
    \item \strong{Call to Order and Confirmation of Quorum}
    \begin{itemize}[leftmargin=1.1em]
        \item Roll call of units present and proxies represented
        \item Confirmation that quorum is satisfied
        {% if meeting.quorum_threshold %}
        \item Required quorum: {{ meeting.quorum_threshold }}\% of eligible votes, in person or by proxy
        {% endif %}
    \end{itemize}

    \item \strong{Approval or Discussion of Prior Annual Meeting Minutes}
    \begin{itemize}[leftmargin=1.1em]
        \item If {{ (meeting_year - 1) }} minutes are available: owner motion to approve
        \item If minutes reflect no quorum or limited business: brief explanation and record in {{ meeting_year }} minutes
    \end{itemize}

    \item \strong{Introduction of Board of Directors and Property Manager}

    \item \strong{Review of Financials}
    \begin{itemize}[leftmargin=1.1em]
        {% if financial.prior_year_end_income or financial.prior_year_end_net %}
        \item {{ (meeting_year - 1) }} year-end results
        {% endif %}
        {% if financial.ytd_income or financial.ytd_expenses %}
        \item {{ meeting_year }} year-to-date financial performance
        {% if financial.ytd_as_of_date %}(through {{ financial.ytd_as_of_date | format_date }}){% endif %}
        {% endif %}
        {% if financial.reserve_fund_balance %}
        \item Overview of reserves
        {% if financial.reserve_fund_balance %} --- current balance: \money{ {{ financial.reserve_fund_balance | format_currency }} }{% endif %}
        {% endif %}
        \item Capital spending and any special assessment history
    \end{itemize}

    \item \strong{Presentation of Approved Budget}
    \begin{itemize}[leftmargin=1.1em]
        {% if financial.prior_budget_total %}
        \item {{ (meeting_year - 1) }} Approved Budget
        {% endif %}
        \item {{ financial.approved_budget_year or meeting_year }} Approved Budget
        {% if financial.approved_budget_total %}
        (total: \money{ {{ financial.approved_budget_total | format_currency }} })
        {% endif %}
    \end{itemize}

    \item \strong{New Business}
    \begin{itemize}[leftmargin=1.1em]
        \item Maintenance, capital projects, insurance, and risk management updates
        \item Any proposed actions requiring owner votes (if applicable)
        {% for item in meeting.special_agenda_items %}
        \item {{ item | tex_escape }}
        {% endfor %}
    \end{itemize}

    {% if election.election_required %}
    \item \strong{Board Nominations and Election of Directors}
    \begin{itemize}[leftmargin=1.1em]
        \item Announcement of positions up for election
              {% if election.seats_up_count %}({{ election.seats_up_count }} seat(s)){% endif %}
              {% if election.director_term_length_years %}and term lengths ({{ election.director_term_length_years }}-year term(s)){% endif %}
        \item Nominations from the floor (in addition to any pre-submitted candidates)
        \item Distribution and collection of ballots and tally
        \item Announcement of election results
    \end{itemize}
    {% else %}
    \item \strong{Board of Directors Report}
    \begin{itemize}[leftmargin=1.1em]
        \item Update from the Board on current association matters
        \item No director election is scheduled for this meeting
    \end{itemize}
    {% endif %}

    \item \strong{Owner Questions and Open Forum}

    \item \strong{Adjournment}
\end{enumerate}

{% if jx.org_meeting_after_annual %}
\vspace{1em}
\noindent\textit{Immediately following adjournment, the Board of Directors will hold its
Organizational Meeting to elect officers for the ensuing year. Unit owners are welcome to observe.}
{% endif %}
