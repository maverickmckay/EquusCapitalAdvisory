%% TOC
\renewcommand{\cftsecfont}{\bfseries}
\renewcommand{\cftsecpagefont}{\bfseries}
\setlength{\cftbeforesecskip}{4pt}

%% ─────────────────────────────────────────────────────────────────
%%  Page headers / footers
%% ─────────────────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\fancyhead[L]{\small\color{midgray}{{ association_name | tex_escape }}}
\fancyhead[R]{\small\color{midgray}{{ meeting_year }} Annual Meeting Packet}
\fancyfoot[C]{\small\color{midgray}Page \thepage\ of \pageref{LastPage}}
\fancyfoot[R]{\small\color{midgray}CONFIDENTIAL — FOR MEMBER USE}

%% Plain style for cover page
\fancypagestyle{plain}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

%% ─────────────────────────────────────────────────────────────────
%%  Custom environments
%% ─────────────────────────────────────────────────────────────────
\tcbuselibrary{skins,breakable}

\newtcolorbox{notebox}{
  colback=lightgray, colframe=navyblue,
  boxrule=0.5pt, arc=3pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  breakable,
}

\newtcolorbox{warningbox}{
  colback=yellow!10, colframe=warnorange,
  boxrule=0.5pt, arc=3pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  breakable,
}

\newenvironment{signatureline}[1]{%
  \vspace{10pt}
  \noindent\textbf{#1}\\[18pt]
  \noindent\rule{0.5\linewidth}{0.4pt}\\
  \noindent\small Signature \hfill Date: \rule{1.5in}{0.4pt}
  \vspace{10pt}
}{}

%% Fillable line
\newcommand{\fillline}[1][3in]{\underline{\hspace{#1}}}

